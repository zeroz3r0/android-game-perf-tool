<?xml version="1.0" encoding="UTF-8"?>
<plugin xmlns="http://www.jetbrains.org/intellij/schema/plugin"
        xmlns:compatibility="http://www.jetbrains.org/intellij/schema/plugin-compatibility">
    
    <id>com.gameperf.plugin</id>
    <name>Game Performance Tool</name>
    <version>0.1.0</version>
    <vendor>GamePerf</vendor>
    <description>Android Studio plugin for measuring game performance - FPS, memory, CPU, and log analysis</description>
    
    <depends>com.intellij.modules.platform</depends>
    <depends>com.intellij.modules.lang</depends>
    
    <idea-version since-build="241" until-build="243.*"/>
    
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="GamePerformance" 
                    anchor="bottom" 
                    factoryClass="com.gameperf.plugin.ui.GamePerfToolWindowFactory"/>
    </extensions>
    
    <actions>
        <action id="GamePerfPlugin.ShowWindow" 
                class="com.gameperf.plugin.GamePerfPlugin"
                text="Show Game Performance"
                description="Show Game Performance Tool Window">
            <add-to-group group-id="MainMenu" anchor="last"/>
            <keyboard-shortcut keymap="$default" first-keystroke="shift ctrl alt G"/>
        </action>
    </actions>
    
    <applicationListeners>
        <listener class="com.gameperf.plugin.GamePerfPluginListener"
                  topic="com.intellij.openapi.project.ProjectManagerListener"/>
    </applicationListeners>
</plugin>
